TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# --- Google auth: pick ONE of the two modes below ---
#
# Mode A - user OAuth (a browser sign-in as yourself).
# Mint token.json with `python main.py --auth` on a machine WITH a browser,
# then copy token.json to the server. The running bot never opens a browser.
# ⚠️ If the OAuth consent screen is left in "Testing" status, Google expires
# the refresh token every 7 days and the bot stops. Publish the app to
# "In production" before relying on this for 24/7.
GOOGLE_CREDENTIALS_PATH=credentials.json

# Mode B - service account (preferred for an unattended 24/7 host: no browser,
# no refresh token, nothing to expire). Set this and GOOGLE_CREDENTIALS_PATH
# is ignored. Share the calendar with the service account's
# ...@....iam.gserviceaccount.com address, granting "Make changes to events".
# GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json

# --- Calendars: pick ONE of the three shapes below ---
#
# Shape A - single calendar (still fully supported):
CALENDAR_ID=

# Shape B - one calendar per child (ADR-003). Leave CALENDAR_ID blank.
# DAUGHTER_2_* is optional; the bot only asks "which child?" once a second
# calendar actually exists.
# DAUGHTER_1_NAME=
# DAUGHTER_1_CALENDAR_ID=
# DAUGHTER_2_NAME=
# DAUGHTER_2_CALENDAR_ID=

# Shape C - per child, per category (ADR-009). Leave CALENDAR_ID and the
# flat DAUGHTER_N_CALENDAR_ID blank. Setting any category var for a child
# switches that child to categorized mode; categories are individually
# optional. This is the shape that lets grandparents see school events
# without seeing enrichment or personal ones, since Google Calendar grants
# access per calendar, never per event.
# DAUGHTER_1_NAME=Child_1
# DAUGHTER_1_SCHOOL_CALENDAR_ID=
# DAUGHTER_1_ENRICHMENT_CALENDAR_ID=
# DAUGHTER_1_OTHERS_CALENDAR_ID=
# DAUGHTER_2_NAME=Child_2
# DAUGHTER_2_SCHOOL_CALENDAR_ID=
# DAUGHTER_2_ENRICHMENT_CALENDAR_ID=
# DAUGHTER_2_OTHERS_CALENDAR_ID=

# Numeric Telegram user ID, not a @username - get yours from @userinfobot
ADMIN_TELEGRAM_ID=123456789
WIFE_TELEGRAM_ID=
MOM_TELEGRAM_ID=
DAD_TELEGRAM_ID=

# Optional. Tokens allowed per CALENDAR MONTH, resetting 00:00 UTC on the 1st.
# Defaults to 3,500,000 (~2,300 messages at the ~1,500 tokens/message measured
# on real traffic). At 80% the admin is warned once a day; past 100% everyone
# except the admin is refused - the admin is never blocked, so /usage and this
# setting stay reachable from a phone. Set it here to raise the cap on the
# server without a code change; a restart is needed for it to take effect.
# MONTHLY_TOKEN_BUDGET=3500000

# Optional. What a message with only ONE time means: "end" (default) or
# "start". "Child_2 piano 5pm" is a pickup time in this family, so the event is
# drawn as the 15 minutes ending at 5. Set this to "start" if your messages are
# mostly drop-offs instead. Either way the wording of an individual message
# wins - "swimming from 8am" is start-anchored whatever this says.
# LONE_TIME_MEANS=end

# Optional. Overrides the parsing model. MUST stay a non-reasoning model:
# gpt-5-nano spent ~1,700 tokens "thinking" per message, costing ~15 seconds
# of wall clock, and turning its reasoning down broke the parses. Defaults to
# gpt-4.1-mini (~1.2s). If you change this, update PRICE_PER_MILLION_TOKENS
# in main.py too, and re-measure both latency and parse quality.
# OPENAI_MODEL=gpt-4.1-mini

# ---- Email to enrichment centres (optional) ----
# Setting this switches the feature ON and adds the gmail.send scope, which
# INVALIDATES the existing token: re-run `python main.py --auth` and copy the
# new token.json to the server. Leave empty and nothing changes.
#
# Only these addresses can ever be written to. An address appearing in a
# message or a forwarded email is never a valid recipient.
ENRICHMENT_EMAILS="Swim Centre <swim@example.com>, Piano Studio <piano@example.com>"
# The account that sends. Usually the same Google account the bot authenticates as.
GMAIL_USER=
# Hard cap on sends per rolling 24h, across everyone. Default 10.
DAILY_EMAIL_LIMIT=10

# ---- Pickups and travel time (optional) ----
# How close two pickups for DIFFERENT children have to be, in minutes, before
# one adult cannot do both. Used only when the journey between the two places
# is unknown; a timed journey answers the question exactly. Default 45.
# PICKUP_BUFFER_MINUTES=45

# How close two of ONE child's events have to be before the bot asks how long
# the journey between them takes. Above this, travel time cannot plausibly be
# the problem and asking would just be noise. Default 90.
# TRAVEL_CHECK_WINDOW_MINUTES=90
